---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Horarios from '../components/Horarios.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Campanario from '../components/Campanario.astro';
import Sacramentos from '../components/Sacramentos.astro';
import Contacto from '../components/Contacto.astro';
import Avisos from '../components/Avisos.astro';
import Eventos from '../components/Eventos.astro';
import FiltroVigencia from '../components/FiltroVigencia.astro';
import { avisosVigentes, flyersVigentes, seccionesVisibles } from '../lib/eventos';

// Sin avisos ni flyers vigentes no hace falta el script de vigencia.
const hayVigencias = avisosVigentes.length > 0 || flyersVigentes.length > 0;

type Componente = typeof Horarios;

// Contenido de cada sección, por id. Las que no figuran quedan solo con el título.
const contenidos: Record<string, Componente | undefined> = {
  eventos: Eventos,
  horarios: Horarios,
  ubicacion: Ubicacion,
  sacramentos: Sacramentos,
  contacto: Contacto,
};

// Bandas decorativas que van justo antes de una sección, por id.
const separadoresAntes: Record<string, Componente | undefined> = {
  sacramentos: Campanario,
};

// Fondo celeste en algunas secciones, para alternar bandas.
const conFondo = new Set(['ubicacion', 'contacto']);
---

<Layout>
  <Avisos />
  <Header />
  <main id="contenido">
    <Hero />
    {
      seccionesVisibles.map((seccion) => {
        const Contenido = contenidos[seccion.id];
        const Separador = separadoresAntes[seccion.id];
        return (
          <>
            {Separador && <Separador />}
            <section
              id={seccion.id}
              aria-labelledby={`${seccion.id}-titulo`}
              class:list={['px-4 py-14 md:py-20', conFondo.has(seccion.id) && 'fondo-celeste']}
            >
              <div class="mx-auto max-w-6xl">
                <TituloSeccion id={`${seccion.id}-titulo`} titulo={seccion.titulo} />
                {Contenido && <Contenido />}
              </div>
            </section>
          </>
        );
      })
    }
  </main>
  <Footer />
  <BotonWhatsApp />
  {hayVigencias && <FiltroVigencia />}
</Layout>
