---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Parroquia Inmaculado Corazón de María">
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="text-dorado text-lg tracking-[0.3em] [font-variant-caps:small-caps]">Parroquia</p>
    <h1 class="text-bordo mt-3 text-3xl leading-tight tracking-[0.12em] [font-variant-caps:small-caps]">
      Inmaculado Corazón de María
    </h1>
  </main>
</Layout>
