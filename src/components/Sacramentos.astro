---
/** Bautismos y charlas pre-bautismales, cada uno en su marco; lado a lado en pantallas anchas. */
import { Image } from 'astro:assets';
import fotoAltar from '../assets/altar-mayor.jpg';
import Arco from './Arco.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import Marco from './Marco.astro';
import Subtitulo from './Subtitulo.astro';
import { enlaceWhatsApp, parroquia } from '../lib/parroquia';

const { bautismos, charlasPreBautismales: charlas, sitio } = parroquia;
const textos = sitio.sacramentos;

const claseTurnos = 'border-t border-celeste text-center text-xl tabular-nums';
const claseTurno = 'border-b border-celeste px-3 py-3 transition-colors duration-300 hover:bg-celeste-claro';
---

<div class="grid items-start gap-14 lg:grid-cols-2 lg:gap-10">
  <Marco>
    <Subtitulo texto={textos.bautismos.titulo} />
    <Arco class="mx-auto mt-4 max-w-sm p-1.5">
      <Image
        src={fotoAltar}
        alt={textos.bautismos.foto.alt}
        widths={[360, fotoAltar.width]}
        sizes="(min-width: 640px) 372px, calc(100vw - 88px)"
        class="aspect-[4/3] w-full object-cover transition-transform duration-1000 ease-suave group-hover/arco:scale-105"
      />
    </Arco>
    <p class="dia mt-6 mb-2 text-center text-xl">{bautismos.dia}</p>
    <ul class={claseTurnos}>
      {bautismos.turnos.map((turno) => <li class={claseTurno}>{turno}</li>)}
    </ul>
    <p class="mt-3 text-center text-base italic text-balance">{bautismos.nota}</p>
  </Marco>

  <Marco>
    <Subtitulo texto={textos.charlas.titulo} />
    <ul class:list={[claseTurnos, 'mt-4']}>
      {charlas.turnos.map((turno) => <li class={claseTurno}>{turno}</li>)}
    </ul>
    <div class="mt-6 border-l-4 border-rosa bg-rosa/5 px-4 py-4 text-center">
      <p class="text-lg font-semibold text-balance text-rosa">{charlas.nota}</p>
      <a
        href={enlaceWhatsApp(textos.charlas.whatsapp.mensaje)}
        target="_blank"
        rel="noopener"
        class="group/wa mt-2 inline-flex min-h-12 items-center gap-2 text-azul underline decoration-oro underline-offset-4 transition-colors duration-300 hover:decoration-azul"
      >
        <IconoWhatsApp class="size-6 shrink-0 transition-transform duration-300 ease-suave group-hover/wa:scale-125 group-hover/wa:-rotate-12" />
        {textos.charlas.whatsapp.etiqueta}
      </a>
    </div>
  </Marco>
</div>
