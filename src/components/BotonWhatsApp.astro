---
import IconoWhatsApp from './IconoWhatsApp.astro';
import { enlaceWhatsApp, parroquia } from '../lib/parroquia';

const { sitio } = parroquia;
---

<a
  href={enlaceWhatsApp(sitio.whatsapp.mensaje)}
  target="_blank"
  rel="noopener"
  aria-label={sitio.whatsapp.etiqueta}
  title={sitio.whatsapp.etiqueta}
  class="animate-flotante fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-md transition-[scale,box-shadow] duration-300 ease-suave before:absolute before:inset-0 before:-z-10 before:animate-onda before:rounded-full before:bg-whatsapp before:opacity-0 hover:scale-110 hover:shadow-lg"
>
  <!-- Entra después del hero y emite tres ondas, como una campana; después queda quieto. -->
  <IconoWhatsApp class="size-8" />
</a>
