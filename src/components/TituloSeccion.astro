---
/** Título de sección (h2) en versalitas doradas, con un filete y una cruz debajo. */
import Ornamento from './Ornamento.astro';

interface Props {
  id: string;
  titulo: string;
}

const { id, titulo } = Astro.props;
---

<div class="mb-12 text-center">
  <h2
    id={id}
    class="revelar font-display text-4xl leading-tight font-semibold tracking-[0.18em] text-dorado-oscuro [font-variant-caps:small-caps] md:text-5xl"
  >
    {titulo}
  </h2>
  <Ornamento class="mx-auto mt-3 max-w-64" />
</div>
