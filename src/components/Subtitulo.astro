---
/**
 * Título de un bloque dentro de una sección (h3), en azul con una estrella
 * dorada debajo. Cada palabra no se parte, así "pre-bautismales" no corta en el guion.
 *
 * `menor`, para los títulos internos de un marco: en celular va un punto más
 * chico y sin la estrella, para no alargar la página; en md y más, igual que el resto.
 */
import Estrella from './Estrella.astro';

interface Props {
  texto: string;
  menor?: boolean;
  class?: string;
}

const { texto, menor = false, class: clase } = Astro.props;
const palabras = texto.split(' ');
---

<div class:list={['mb-2 text-center md:mb-3', clase]}>
  <h3 class:list={['font-display leading-tight font-semibold text-balance text-azul', menor ? 'text-2xl md:text-3xl' : 'text-3xl']}>
    {
      palabras.map((palabra, i) => (
        <>
          {i > 0 && ' '}
          <span class="whitespace-nowrap">{palabra}</span>
        </>
      ))
    }
  </h3>
  <div class:list={['mt-2 items-center justify-center gap-2 text-oro', menor ? 'hidden md:flex' : 'flex']} aria-hidden="true">
    <span class="h-px w-8 bg-current"></span>
    <Estrella class="size-3" />
    <span class="h-px w-8 bg-current"></span>
  </div>
</div>
