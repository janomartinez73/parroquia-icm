---
/**
 * Portada sobre cielo azul noche: la corona de doce estrellas sobre el
 * Inmaculado Corazón, el nombre, la dirección, la próxima misa y los accesos
 * directos. En pantallas anchas, la fachada va a la derecha en un arco, con un
 * rosetón grande detrás.
 *
 * Al cargar, cada parte entra una tras otra: las demoras en ms van en orden.
 */
import { Image } from 'astro:assets';
import fotoFrente from '../assets/frente-parroquia.jpg';
import Arco from './Arco.astro';
import Boton from './Boton.astro';
import CoronaEstrellas from './CoronaEstrellas.astro';
import Emblema from './Emblema.astro';
import Ornamento from './Ornamento.astro';
import ProximaMisa from './ProximaMisa.astro';
import Roseton from './Roseton.astro';
import Tramos from './Tramos.astro';
import { enlaceComoLlegar, parroquia } from '../lib/parroquia';

const { sitio, barrio, comunidad, direccion } = parroquia;
---

<section class="fondo-cielo relative overflow-hidden border-b-4 border-double border-oro px-4 py-12 text-marfil md:py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[1fr_auto] lg:gap-20">
    <div class="text-center md:text-left">
      <!-- La corona rodea al Corazón desde arriba. -->
      <div class="relative mx-auto h-28 w-52 text-oro md:mx-0 md:h-32 md:w-60">
        <CoronaEstrellas alCargar={0} class="absolute inset-x-0 top-0 w-full" />
        <Emblema class="animate-emblema absolute bottom-0 left-1/2 h-20 w-18 -translate-x-1/2 [animation-delay:250ms] md:h-24 md:w-21" />
      </div>

      <h1 class="mt-6 text-balance">
        <span
          class="font-capitales animate-aparecer block text-base font-semibold tracking-[0.45em] text-oro uppercase [animation-delay:400ms] md:text-lg"
        >
          {sitio.marca.antetitulo}
        </span>
        <span
          class="font-display animate-aparecer mt-3 block text-5xl leading-[1.05] font-semibold [animation-delay:520ms] md:text-6xl lg:text-7xl"
        >
          {sitio.marca.titulo}
        </span>
      </h1>
      <Ornamento alCargar={700} class="mx-auto my-6 max-w-sm text-oro md:mx-0" />
      <p class="animate-aparecer text-lg text-balance text-celeste [animation-delay:850ms]">
        <Tramos tramos={[direccion.calle, barrio, direccion.ciudad]} />
      </p>
      <p class="animate-aparecer mt-1 text-base text-balance text-celeste/85 italic [animation-delay:920ms]">
        {sitio.pie.comunidad} {comunidad}
      </p>

      <ProximaMisa class="animate-aparecer mx-auto mt-7 max-w-md [animation-delay:1000ms] md:mx-0" />

      <div
        class="animate-aparecer mt-7 flex flex-col gap-3 [animation-delay:1100ms] sm:flex-row sm:justify-center md:flex-col md:items-start md:justify-start lg:flex-row"
      >
        <Boton href="#horarios" variante="dorado">{sitio.hero.verHorarios}</Boton>
        <Boton href={enlaceComoLlegar} externo variante="claro">{sitio.ubicacion.comoLlegar}</Boton>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-72 md:max-w-80 lg:max-w-96">
      <!-- Rosetón grande de fondo, apenas visible, girando despacio al entrar. -->
      <!-- Trazo fino: agrandado, el grosor normal se vería como anillos pesados. -->
      <Roseton
        class="animate-giro absolute top-1/2 left-1/2 w-[160%] max-w-none -translate-1/2 text-oro/35 [animation-delay:200ms] [&_circle]:[stroke-width:0.35]"
      />
      <Arco class="animate-arco relative bg-noche p-2 [animation-delay:350ms]">
        <!-- Proporción propia de la foto (9:16): el arco recorta solo cielo, la torre entra entera. -->
        <Image
          src={fotoFrente}
          alt={sitio.hero.alt}
          widths={[320, 640, 768]}
          sizes="(min-width: 1024px) 368px, (min-width: 768px) 304px, 272px"
          priority
          class="aspect-[9/16] w-full object-cover object-top transition-transform duration-1000 ease-suave group-hover/arco:scale-105"
        />
      </Arco>
    </div>
  </div>
</section>
