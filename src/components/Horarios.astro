---
/**
 * Horarios de misa y apertura del templo, cada uno en su marco. En pantallas
 * anchas van lado a lado.
 *
 * El HTML sale completo del build, con todos los días. El bloque de hoy lo
 * marca el script en el cliente: si el JS falla, los horarios se ven igual.
 * La línea de próxima misa está en el hero (ProximaMisa.astro).
 */
import Marco from './Marco.astro';
import Subtitulo from './Subtitulo.astro';
import { parroquia } from '../lib/parroquia';
import { DIAS_APERTURA, SEMANA } from '../lib/horarios';
import type { Apertura, DiaSemana, Hora } from '../types/parroquia';

const { misas, apertura, sitio } = parroquia;
const textos = sitio.horarios;

const lista = new Intl.ListFormat('es', { type: 'conjunction' });
const nombrarDias = (dias: DiaSemana[]) => lista.format(dias.map((dia) => textos.dias[dia].plural));

// Días con los mismos horarios, en orden de la semana.
const gruposMisas: { dias: DiaSemana[]; horas: Hora[] }[] = [];
for (const dia of SEMANA) {
  const horas = misas[dia];
  if (horas.length === 0) continue;
  const grupo = gruposMisas.find((g) => g.horas.join() === horas.join());
  if (grupo) grupo.dias.push(dia);
  else gruposMisas.push({ dias: [dia], horas });
}

const diasSinMisa = SEMANA.filter((dia) => misas[dia].length === 0);
const textoSinMisa = textos.misas.sinMisa.replace('{dias}', nombrarDias(diasSinMisa).toLocaleLowerCase('es'));

const gruposApertura = (Object.keys(DIAS_APERTURA) as (keyof Apertura)[]).map((clave) => ({
  dias: DIAS_APERTURA[clave],
  nombre: textos.apertura[clave],
  tramos: apertura[clave],
}));

const claseGrupo =
  'relative border-b border-dorado/40 px-2.5 py-4 transition-colors duration-300 hover:bg-dorado/10 hoy:bg-dorado/15 sm:px-3';
// Apoyado sobre el separador de arriba, para no quitarle ancho al nombre del grupo.
// Cae como un sello cuando el script marca el día de hoy.
const claseIndicador =
  'absolute -top-3 right-3 hidden rounded-sm border border-bordo/40 bg-crema px-2 text-sm leading-5 tracking-[0.15em] text-bordo hoy:block hoy:animate-sello [font-variant-caps:all-small-caps]';
---

<div class="grid items-start gap-14 lg:grid-cols-5 lg:gap-10">
  <Marco class="lg:col-span-3">
    <Subtitulo texto={textos.misas.titulo} />
    <ul class="mt-4 border-t border-dorado/40">
      {
        gruposMisas.map((grupo) => (
          <li data-dias={grupo.dias.join(' ')} class:list={[claseGrupo, 'sm:grid sm:grid-cols-[12rem_1fr] sm:items-center sm:gap-6']}>
            <span class={claseIndicador}>{textos.indicadorHoy}</span>
            <span class="dia block text-balance">{nombrarDias(grupo.dias)}</span>
            <ul class="flex flex-wrap gap-x-4 text-[1.625rem] leading-snug tabular-nums sm:gap-x-5 sm:text-4xl">
              {grupo.horas.map((hora) => (
                <li>
                  <time datetime={hora}>{hora}</time>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    {
      diasSinMisa.length > 0 && (
        <p data-dias={diasSinMisa.join(' ')} class="mt-4 text-center text-base italic hoy:font-semibold hoy:text-bordo">
          {textoSinMisa}
        </p>
      )
    }
  </Marco>

  <Marco class="lg:col-span-2">
    <Subtitulo texto={textos.apertura.titulo} />
    <ul class="mt-4 border-t border-dorado/40">
      {
        gruposApertura.map((grupo) => (
          <li data-dias={grupo.dias.join(' ')} class={claseGrupo}>
            <span class={claseIndicador}>{textos.indicadorHoy}</span>
            <span class="dia block">{grupo.nombre}</span>
            <ul class="flex flex-wrap gap-x-6 text-xl leading-snug tabular-nums">
              {grupo.tramos.map((tramo) => (
                <li class="whitespace-nowrap">{tramo}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Marco>
</div>

<script>
  import { diaActual } from '../lib/horarios';

  const hoy = diaActual();

  document.querySelectorAll<HTMLElement>('[data-dias]').forEach((bloque) => {
    if (bloque.dataset.dias?.split(' ').includes(hoy)) bloque.classList.add('hoy');
  });
</script>
