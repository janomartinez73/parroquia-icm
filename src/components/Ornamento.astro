---
/**
 * Filete con un rosetón entre dos estrellas, para separar títulos y bloques.
 * El color sale de la clase (text-*). Decorativo.
 *
 * Los filetes se dibujan desde el centro hacia afuera y el rosetón entra
 * girando: al cargar la página (alCargar) o a medida que aparece con el scroll.
 */
import Estrella from './Estrella.astro';
import Roseton from './Roseton.astro';

interface Props {
  class?: string;
  /** Anima al cargar, con esta demora en ms, en vez de seguir al scroll. */
  alCargar?: number;
}

const { class: clase, alCargar } = Astro.props;

const trazo = alCargar === undefined ? 'revelar-trazo' : 'animate-trazo';
const giro = alCargar === undefined ? 'revelar-giro' : 'animate-giro';
const demora = alCargar === undefined ? undefined : `animation-delay: ${alCargar}ms`;
const demoraCentro = alCargar === undefined ? undefined : `animation-delay: ${alCargar + 150}ms`;
---

<div class:list={['flex items-center gap-2.5', clase]} aria-hidden="true">
  <span class:list={['h-px flex-1 origin-right bg-current', trazo]} style={demora}></span>
  <Estrella class="size-3 shrink-0" />
  <span class:list={['shrink-0', giro]} style={demoraCentro}><Roseton class="size-7" /></span>
  <Estrella class="size-3 shrink-0" />
  <span class:list={['h-px flex-1 origin-left bg-current', trazo]} style={demora}></span>
</div>
