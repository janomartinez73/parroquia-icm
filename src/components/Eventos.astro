---
/**
 * Grilla de flyers vigentes. index.astro solo la incluye si hay alguno.
 *
 * Cada flyer va en una caja 4:5 con object-fit contain: entra entero, sin
 * recortes, cualquiera sea su proporción.
 */
import { Image } from 'astro:assets';
import { flyersVigentes, ID_SECCION_EVENTOS, MAXIMO_FLYERS } from '../lib/eventos';

// Flex en lugar de grid: si queda un flyer solo en la fila, va centrado.
const claseFlyer = 'w-full sm:w-[calc(50%-1.25rem)] lg:w-[calc(33.333%-1.667rem)]';

// Nunca más ancho que el original.
const anchos = (original: number) => [...new Set([400, 800].map((ancho) => Math.min(ancho, original)))];
---

<ul data-vigencia={ID_SECCION_EVENTOS} data-maximo={MAXIMO_FLYERS} class="flex flex-wrap justify-center gap-10">
  {
    flyersVigentes.map((flyer, i) => (
      <li data-hasta={flyer.hasta} hidden={i >= MAXIMO_FLYERS} class={claseFlyer}>
        <figure class="revelar">
          <div class="hornacina border-2 border-oro bg-white p-2 shadow-[0_1rem_2rem_-1.5rem_rgb(19_33_63/0.35)] transition-[translate,box-shadow] duration-300 ease-suave hover:-translate-y-1.5 hover:shadow-[0_1.25rem_2rem_-1rem_rgb(19_33_63/0.45)]">
            <Image
              src={flyer.imagen}
              alt={flyer.titulo}
              widths={anchos(flyer.imagen.width)}
              sizes="(min-width: 1024px) 350px, (min-width: 640px) calc(50vw - 56px), calc(100vw - 56px)"
              class="hornacina aspect-[4/5] w-full bg-celeste-claro object-contain"
            />
          </div>
          <figcaption class="font-display mt-3 text-center text-2xl leading-tight font-semibold text-balance text-azul">
            {flyer.titulo}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
