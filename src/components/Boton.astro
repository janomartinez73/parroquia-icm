---
/**
 * Enlace con aspecto de botón, en capitales romanas.
 * - principal: azul mariano, para la acción más importante sobre fondo claro.
 * - dorado: la acción principal sobre el cielo azul noche.
 * - contorno: secundario sobre fondo claro.
 * - claro: secundario sobre el cielo azul noche.
 */
interface Props {
  href: string;
  /** Abre en otra pestaña (Google Maps, WhatsApp). */
  externo?: boolean;
  variante?: 'principal' | 'dorado' | 'contorno' | 'claro';
  class?: string;
}

const { href, externo = false, variante = 'contorno', class: clase } = Astro.props;

const variantes = {
  principal: 'border-azul bg-azul text-marfil hover:border-noche hover:bg-noche',
  dorado: 'border-oro bg-oro text-noche hover:border-marfil hover:bg-marfil',
  contorno: 'border-azul bg-transparent text-azul hover:bg-azul hover:text-marfil',
  claro: 'border-marfil/70 bg-transparent text-marfil hover:border-oro hover:text-oro',
};
---

<a
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  class:list={[
    // Se eleva al pasar el mouse y se hunde al tocarlo.
    'font-capitales inline-flex min-h-14 items-center justify-center gap-3 rounded-sm border-2 px-6 py-2 text-base font-semibold tracking-[0.12em] transition-[color,background-color,border-color,translate,box-shadow] duration-300 ease-suave hover:-translate-y-0.5 hover:shadow-[0_0.6rem_1.2rem_-0.6rem_rgb(19_33_63/0.5)] active:translate-y-0 active:shadow-none',
    variantes[variante],
    clase,
  ]}
>
  <slot />
</a>
