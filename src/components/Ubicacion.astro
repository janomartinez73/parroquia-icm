---
import { Image } from 'astro:assets';
import fotoFrente from '../assets/frente-parroquia.jpg';
import Boton from './Boton.astro';
import { enlaceComoLlegar, enlaceMapaEmbebido, parroquia } from '../lib/parroquia';

const { direccion, barrio, sitio } = parroquia;
const textos = sitio.ubicacion;
---

<div class="mt-6 grid items-center gap-8 md:grid-cols-2">
  <div class="text-center">
    <address class="not-italic">
      <p class="font-display text-4xl leading-tight font-semibold text-balance">{direccion.calle}</p>
      <p class="mt-1 text-xl text-balance">{direccion.esquina}</p>
      <p class="mt-3 text-base text-balance">{[barrio, direccion.ciudad, direccion.provincia].join(', ')}</p>
    </address>
    <Boton href={enlaceComoLlegar} externo class="mt-6">{textos.comoLlegar}</Boton>
  </div>

  <!-- Recorte vertical desde abajo: queda a la vista la torre, el rosetón y el cartel sobre la puerta. -->
  <Image
    src={fotoFrente}
    alt={textos.foto.alt}
    width={720}
    widths={[360, 720]}
    sizes="(max-width: 392px) calc(100vw - 32px), 360px"
    class="mx-auto aspect-[3/4] w-full max-w-xs rounded-sm object-cover object-bottom"
  />
</div>

<iframe
  src={enlaceMapaEmbebido}
  title={textos.mapaTitulo}
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"
  class="mt-8 block h-64 w-full rounded-sm border border-dorado/40 md:h-96"></iframe>
