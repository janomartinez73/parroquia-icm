---
/** Dirección, botón para llegar y foto de la esquina; en pantallas anchas, el mapa al costado. */
import { Image } from 'astro:assets';
import fotoEsquina from '../assets/esquina-parroquia.jpg';
import Arco from './Arco.astro';
import Boton from './Boton.astro';
import { enlaceComoLlegar, enlaceMapaEmbebido, parroquia } from '../lib/parroquia';

const { direccion, barrio, sitio } = parroquia;
const textos = sitio.ubicacion;
---

<div class="grid gap-10 lg:grid-cols-5 lg:items-stretch">
  <div class="flex flex-col items-center gap-8 text-center lg:col-span-2">
    <div class="revelar">
      <address class="not-italic">
        <p class="font-display text-4xl leading-tight font-semibold text-balance text-azul md:text-5xl">{direccion.calle}</p>
        <p class="font-capitales mt-2 text-sm font-semibold tracking-[0.14em] text-oro-oscuro uppercase text-balance">{direccion.esquina}</p>
        <p class="mt-3 text-base text-balance">{[barrio, direccion.ciudad, direccion.provincia].join(', ')}</p>
      </address>
      <Boton href={enlaceComoLlegar} externo class="mt-6">{textos.comoLlegar}</Boton>
    </div>

    <Arco class="revelar w-full max-w-72 p-2">
      <Image
        src={fotoEsquina}
        alt={textos.foto.alt}
        widths={[fotoEsquina.width]}
        sizes="272px"
        class="aspect-[3/4] w-full object-cover transition-transform duration-1000 ease-suave group-hover/arco:scale-105"
      />
    </Arco>
  </div>

  <iframe
    src={enlaceMapaEmbebido}
    title={textos.mapaTitulo}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="revelar hornacina block h-80 w-full border-2 border-oro bg-celeste md:h-96 lg:col-span-3 lg:h-full lg:min-h-[32rem]"
  ></iframe>
</div>
