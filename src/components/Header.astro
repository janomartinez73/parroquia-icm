---
import Emblema from './Emblema.astro';
import { parroquia } from '../lib/parroquia';
import { seccionesVisibles as secciones } from '../lib/eventos';

const { marca, menu } = parroquia.sitio;

// Las tres rayas del ícono giran sobre su centro para formar la X.
const raya = 'origin-center transition-[translate,rotate,scale,opacity] duration-300 ease-suave [transform-box:fill-box]';
---

<header class="sombra-al-bajar sticky top-0 z-40 border-b-2 border-oro bg-marfil/95">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-3 px-4 py-2">
    <a href="#" class="group/marca flex min-h-12 items-center gap-2.5 leading-tight text-tinta no-underline">
      <Emblema
        class="hidden h-10 w-9 shrink-0 text-oro-oscuro transition-transform duration-500 ease-suave group-hover/marca:scale-110 min-[400px]:block"
      />
      <span class="flex flex-col">
        <span class="font-capitales block text-xs tracking-[0.3em] text-oro-oscuro uppercase">
          {marca.antetitulo}
        </span>
        <span class="font-display block text-lg font-semibold text-azul min-[360px]:whitespace-nowrap sm:text-xl">
          {marca.titulo}
        </span>
      </span>
    </a>

    <nav aria-label={menu.etiqueta}>
      <ul class="hidden gap-7 lg:flex">
        {
          secciones.map((seccion) => (
            <li>
              <a
                href={`#${seccion.id}`}
                class="font-capitales relative flex min-h-12 items-center text-sm font-semibold tracking-[0.14em] text-tinta uppercase transition-colors duration-300 after:absolute after:inset-x-0 after:bottom-2 after:h-0.5 after:origin-center after:scale-x-0 after:bg-oro after:transition-transform after:duration-300 after:ease-suave hover:text-azul hover:after:scale-x-100"
              >
                {seccion.titulo}
              </a>
            </li>
          ))
        }
      </ul>

      <details class="group lg:hidden" data-menu>
        <summary
          class="font-capitales flex min-h-12 cursor-pointer list-none items-center gap-1.5 rounded-sm border-2 border-azul/40 px-2.5 text-sm font-semibold tracking-[0.1em] text-azul uppercase transition-colors duration-300 group-open:border-azul group-open:bg-azul group-open:text-marfil hover:border-azul [&::-webkit-details-marker]:hidden"
        >
          <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path class:list={[raya, 'group-open:translate-y-[5px] group-open:rotate-45']} d="M4 7h16" />
            <path class:list={[raya, 'group-open:scale-x-0 group-open:opacity-0']} d="M4 12h16" />
            <path class:list={[raya, 'group-open:-translate-y-[5px] group-open:-rotate-45']} d="M4 17h16" />
          </svg>
          <span>{menu.boton}</span>
        </summary>
        <!-- Aparece con fundido al abrir (starting:) y se desvanece al cerrar. -->
        <ul
          class="absolute inset-x-0 top-full -translate-y-3 border-b-2 border-oro bg-marfil px-4 py-2 opacity-0 shadow-[0_1rem_1.5rem_-1rem_rgb(19_33_63/0.4)] transition-[opacity,translate] duration-300 ease-suave group-open:translate-y-0 group-open:opacity-100 starting:group-open:-translate-y-3 starting:group-open:opacity-0"
        >
          {
            secciones.map((seccion, i) => (
              <li
                style={`--i: ${i}`}
                class="border-b border-celeste transition-[opacity,translate] delay-[calc(var(--i)*50ms_+_80ms)] duration-400 ease-suave last:border-b-0 starting:-translate-x-4 starting:opacity-0"
              >
                <a
                  href={`#${seccion.id}`}
                  class="font-capitales flex min-h-13 items-center gap-3 text-base font-semibold tracking-[0.14em] text-tinta uppercase transition-[color,padding] duration-300 hover:pl-2 hover:text-azul"
                >
                  {seccion.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<script is:inline>
  // Cierra el menú mobile al elegir una sección.
  document.querySelectorAll('[data-menu] a').forEach((enlace) => {
    enlace.addEventListener('click', () => enlace.closest('details').removeAttribute('open'));
  });
</script>
